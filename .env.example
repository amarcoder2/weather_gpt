# ==============================================================================
# WEATHERGPT ENVIRONMENT VARIABLES TEMPLATE (SIH 2026 #26068)
# Ministry of Earth Sciences / India Meteorological Department
# ==============================================================================
# NEVER COMMIT ACTUAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL

# Application & Runtime
NODE_ENV=development
PORT=5001
# Leave NEXT_PUBLIC_API_URL empty on Vercel to route automatically to /api serverless routes:
NEXT_PUBLIC_API_URL=

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE CONFIGURATION (Vercel Postgres / Neon / Supabase / Local)
# Automatically runs table migration on startup (creates users table if not exists)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/weathergpt?sslmode=disable
# Or for Neon/Supabase cloud pooling:
# DATABASE_URL=postgresql://user:pass@ep-cool-fog.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=generate-a-strong-random-secret-key-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# SIH 2026 JUDGING & SECURE DEMO ACCOUNT SEEDING (Optional)
# Used by: npm run db:seed
# CRITICAL: Passwords are NEVER hardcoded into source code or exposed in frontend.
# Set these variables only in your private environment or during evaluation.
# ------------------------------------------------------------------------------
DEMO_ADMIN_EMAIL=admin@weathergpt.gov.in
DEMO_ADMIN_PASSWORD=
DEMO_USER_EMAIL=user@weathergpt.gov.in
DEMO_USER_PASSWORD=

# ------------------------------------------------------------------------------
# GEOCODING & WEATHER PROVIDERS (Optional - Open-Meteo & BigDataCloud work without keys)
# ------------------------------------------------------------------------------
GEOCODING_API_KEY=
WEATHER_API_KEY=
OPENWEATHER_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# FRONTEND FIREBASE WEB SDK (Optional - preserved for legacy telemetry)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=weather-gpt-sih.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=weather-gpt-sih
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=weather-gpt-sih.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
