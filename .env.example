# ==============================================================================
# WEATHERGPT ENVIRONMENT VARIABLES TEMPLATE (SIH 2026 #26068)
# Ministry of Earth Sciences / India Meteorological Department
# ==============================================================================
# NEVER COMMIT ACTUAL SECRETS OR PRIVATE KEYS TO VERSION CONTROL

# Application & Runtime
NODE_ENV=development
PORT=5001
NEXT_PUBLIC_API_URL=http://localhost:5001/weather-gpt-sih/asia-south1/api/v1

# ------------------------------------------------------------------------------
# FRONTEND FIREBASE WEB SDK (Obtain from Firebase Console > Project Settings > General)
# Public configuration for client browser initialization (src/lib/firebase/firebase.ts)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=weather-gpt-sih.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=weather-gpt-sih
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=weather-gpt-sih.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# BACKEND FIREBASE ADMIN SDK (Cloud Functions)
# Used server-side only for token verification, custom claims, and Firestore
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=weather-gpt-sih
# Unused by current Admin SDK (uses ADC / Google Cloud Managed Identity in production):
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@weather-gpt-sih.iam.gserviceaccount.com
# For local dev with service account key (Optional when running with Firebase Local Emulator):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ------------------------------------------------------------------------------
# FIREBASE EMULATOR SUITE (Local Development & Integration Testing)
# ------------------------------------------------------------------------------
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_FUNCTIONS_EMULATOR_HOST=localhost:5001

# ------------------------------------------------------------------------------
# SERVER-SIDE EXTERNAL API INTEGRATIONS (Cloud Functions Environment Only)
# Configure via Firebase Secret Manager / Functions env; NEVER in client bundle or Git
# ------------------------------------------------------------------------------
# Google Gemini 1.5/2.0 API Key for live conversational reasoning
GEMINI_API_KEY=

# Real Weather Provider (OpenWeatherMap / Meteorological feed)
WEATHER_API_KEY=
OPENWEATHER_API_KEY=

# Future Media & Dissemination Placeholders
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

